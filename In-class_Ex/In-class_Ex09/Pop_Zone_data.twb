      <aliases enabled='yes' />
      <column caption='Total population' datatype='integer' name='[Calculation_673288167439781888]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pop])' />
      </column>
      <column caption='Female' datatype='integer' name='[Calculation_673288167444459525]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Sex] = &apos;Females&apos;&#13;&#10;Then [Pop]&#13;&#10;END' />
      </column>
      <column caption='Male' datatype='integer' name='[Calculation_673288167444742150]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='If [Sex] = &apos;Males&apos;&#13;&#10;Then [Pop]&#13;&#10;END' />
      </column>
      <column caption='Population Density' datatype='real' name='[Calculation_673288167453532167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pop])/SUM(AREA([Geometry],&apos;km&apos;))' />
      </column>
      <column caption='log10 TotalPop' datatype='real' name='[Calculation_673288167456268298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([Calculation_673288167439781888])' />
      </column>
      <column caption='log10 Pop Density' datatype='real' name='[Calculation_673288167456391179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOG([Calculation_673288167453532167])' />
      </column>
