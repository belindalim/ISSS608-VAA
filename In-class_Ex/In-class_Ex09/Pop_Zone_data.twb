        <calculation class='tableau' formula='IF [Calculation_673288167439781888] &lt; WINDOW_PERCENTILE([Calculation_673288167439781888], 0.33) THEN &quot;Low&quot;&#13;&#10;ELSEIF [Calculation_673288167439781888] &lt; WINDOW_PERCENTILE([Calculation_673288167439781888], 0.66) THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END'>
